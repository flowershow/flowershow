{
  "name": "markdown-processing-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare worker for parsing markdown files and updating metadata in a connected database",
  "main": "src/worker.js",
  "scripts": {
    "dev": "wrangler dev --local --config wrangler.flowershow.toml --env dev",
    "lint": "biome lint .",
    "build:core": "pnpm --filter @flowershow/core build",
    "deploy:staging": "pnpm run build:core && npx wrangler deploy --config wrangler.flowershow.toml --keep-vars --env staging",
    "deploy:production": "pnpm run build:core && npx wrangler deploy --config wrangler.flowershow.toml --keep-vars --env production",
    "test": "vitest run --config vitest.unit.config.js",
    "test:e2e": "vitest run --config vitest.e2e.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "~0.12.21",
    "@cloudflare/workers-types": "^4.20260621.1",
    "docx": "^9.15.4",
    "vitest": "catalog:",
    "wrangler": "^4.149.0"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@flowershow/core": "workspace:*",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "^9.0.7",
    "hast-util-to-mdast": "^10.1.3",
    "image-size": "^2.0.3",
    "mammoth": "^1.13.0",
    "postgres": "^3.4.4",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}